  "_meta": {
    "ticket": "VCST-6078",
    "purpose": "Buyer /account/dashboard statistics (X-Frontend orderStatistics: token customer + token org, store filter, !IsCancelled && !IsPrototype, per-currency fold, unconfigured currency -> excludedCount) + My recent orders.",
    "seeder": "scripts/seed-data/orders/seed-buyer-dashboard.mjs (npm run seed:buyer-dashboard)",
    "guard": "scripts/seed-data/orders/validate-buyer-dashboard-data.mjs (npm run td:validate:buyer-dashboard)",
    "createdDateLimit": "CustomerOrder.createdDate is server-assigned (KB-971BC129): every order lands at the seed instant. Past windows (last week, last month, last year) cannot be populated, so on the storefront every delta has a zero baseline and is not shown. Period-over-period divergence is carried by two creation WAVES (prev, cur) whose real instants the seeder writes to aliases.<env>.json; orderStatistics comparison(current, previous) over those instants is where count and revenue changes disagree.",
    "expected": "Every expected block is DERIVED by buyer-dashboard-specs.mjs expectedFigures() and checked against these declared values by the guard; edit an order and the guard tells you which expectation moved.",
    "noRuntimeIds": "No GUID, createdDate or order id lives here: they are written to test-data/aliases.<env>.json by the seeder.",
    "demoTargets": "Opt-in orders for an EXISTING env persona (resolved from {{emailVar}} / {{passwordVar}}; its org is the org of its storefront token). Seeded ONLY by --only <KEY>, removed by --teardown --only <KEY>; the persona, its org and its carts are never created, changed or deleted. Not part of the default seed."
  },
