  "_meta": {
    "description": "Presentation-grade returns demo (seed-returns-demo.mjs). Stands on the sales-rep demo: org/buyer keys are DEMO_ORGS / DEMO_CONTACTS in sales-rep-demo-specs.mjs. No AGENT-TEST string, no GUID, no SKU — products are discovered per org, reason codes are checked against the LIVE store, the window against the LIVE returnPolicy.",
    "fields": {
      "orders[].deliveredDaysAgo": "shipment DeliveryDate offset from seed time — the date the return window is computed from",
      "orders[].lines[]": "ordered qty + unit price; one distinct discovered product per line; quantities distinct within an order",
      "returns[].outcome": "final status: Draft | Requested | Approved | PartiallyApproved | Rejected | Cancelled | Completed",
      "returns[].lines[].line": "1-based index into the order lines",
      "returns[].lines[].approve": "approved qty (decided outcomes only); 0 = declined",
      "returns[].seq": "submit order — the platform numbers returns in creation order"
    }
  },
