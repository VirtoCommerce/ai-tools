{
  "_meta": {
    "description": "Presentation-grade returns demo (seed-returns-demo.mjs). Stands on the sales-rep demo: org/buyer keys are DEMO_ORGS / DEMO_CONTACTS in sales-rep-demo-specs.mjs. No AGENT-TEST string, no GUID, no SKU — products are discovered per org, reason codes are checked against the LIVE store, the window against the LIVE returnPolicy.",
    "fields": {
      "orders[].deliveredDaysAgo": "shipment DeliveryDate offset from seed time — the date the return window is computed from",
      "orders[].lines[]": "ordered qty + unit price; one distinct discovered product per line; quantities distinct within an order",
      "returns[].outcome": "final status: Draft | Requested | New | Approved | PartiallyApproved | Rejected | Cancelled | Processing | Completed. Processing/Completed are reached after the decision (approve values decide Approved vs PartiallyApproved first)",
      "returns[].lines[].line": "1-based index into the order lines",
      "returns[].lines[].approve": "approved qty (decided outcomes only); 0 = declined",
      "returns[].seq": "submit order — the platform numbers returns in creation order",
      "returns[].via": "omitted = the buyer submits through the storefront flow; \"agent\" = a back-office agent logs it on the buyer's behalf (status New, no evidence required)",
      "orgReturnsAccess": "a demo-owned role holding ONLY the organization-returns permissions (view, submit), ADDED (never replacing) to the listed buyers' memberships and to every login of the listed reps in the listed served orgs, and appended to the store's membership-roles whitelist when one is active; teardown takes all of it back. The id keeps its first name (viewer) so the grants already made stay attached",
      "orders[].owner": "instead of buyer: a REP's own order — {rep, login}, login = \"record\" (the account the sales-rep record points at) or \"email\" (the rep's declared email login). The rep places it inside a served org and submits its returns as herself; the order address email is the org's .example mailbox"
    }
  },
  "currency": "USD",
