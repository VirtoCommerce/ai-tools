# ==============================================================================
# vcptcore-stable environment — dedicated latest-STABLE instance (hotfix landing zone).
# Activate: TEST_ENV=vcptcore_stable npm run env:check
# Committed; URLs/identifiers only — test-account logins and passwords live in
# test-accounts.local.json (envs.vcptcore_stable); tokens in vc-secrets / .env.local.
# ==============================================================================

# --- Risk gate ---------------------------------------------------------------
# QA env — admin-write suites + seeders allowed (not production).
ENV_RISK=test

# --- Knowledge base -----------------------------------------------------------
# The name the kb records observations on this stand under. Every alias of this
# profile (env name, BACK_URL / FRONT_URL host) is mapped onto it at the write door
# (scripts/kb/core/stands.mjs). Changing it renames the stand in new evidence only.
KB_STAND=vcptcore_stable

# --- Application URLs --------------------------------------------------------
FRONT_URL=https://vcptcore-stable-storefront.govirto.com
BACK_URL=https://vcptcore-stable.govirto.com
STORYBOOK_URL=https://vcptcore-stable-storybook.govirto.com
STORYBOOK_DEV_URL=https://vcptcore-stable-storybook.govirto.com

# --- Deploy manifest (hotfix delivery target — read by /qa-hotfix-check) ------
# This env is provisioned from vc-deploy-dev @ this branch's backend/packages.json.
# `scripts/hotfix-deliver.ts` bumps a module/Platform version here (commit
# "VCST-XXXX: <title>"), then waits for the deploy Action + polls /api/platform/modules.
DEPLOY_REPO=VirtoCommerce/vc-deploy-dev
DEPLOY_BRANCH=vcptcore-stable
DEPLOY_PACKAGES_PATH=backend/packages.json
DEPLOY_PACKAGES_URL=https://github.com/VirtoCommerce/vc-deploy-dev/blob/vcptcore-stable/backend/packages.json

# --- Store configuration -----------------------------------------------------
STORE_ID=B2B-store
STOREFRONT_DOMAIN=vcptcore-stable-storefront.govirto.com
# B2B-store catalog (B2B-mixed) + main fulfillment center, from /api/stores (2026-07-01).
STORE_CATALOG_ID=fc596540864a41bf8ab78734ee7353a3
MAIN_FULFILLMENT_CENTER_ID=142ba5568ae4454aad553ece41b9c3b5
# TODO: real GUID of the USER account (discover via `me { id }` after first auth)
TEST_USER_ID=

ADMIN_URL=https://vcptcore-stable.govirto.com

# --- Test accounts: logins and passwords are in test-accounts.local.json (npm run creds:check) ---
# Personas provisioned 2026-07-01 to mirror vcst (Contact + Customer security account,
# storeId=B2B-store), mapped to the seed:b2b fixture accounts as vcst maps them. Login and
# org context verified 2026-07-01 (/connect/token + storefront smoke).
ORG_USER_ID=
# LOYALTY_VIP_USER: NO seed:b2b equivalent on qa1 — the loyalty module is NOT installed, so a
# loyalty-VIP persona is not reproducible here. Absent until a loyalty-capable env exists.
# IMPERSONATION_ADMIN: NO seed:b2b equivalent — needs a userType=Manager account (seed:b2b does
# not create one). Absent until provisioned separately.

# --- Seed fixtures (provisioned via npm run seed:* — see test-data/_seed-results-*) -
VALID_COUPON_CODE=VALID10
OOS_SKU=QA-OOS-001
LOW_STOCK_SKU=QA-LOW-001
PACK_SIZE_SKU=QA-PACK-001
TIER_PRICED_SKU=QA-TIER-001
CONFIGURABLE_SKU=
