# ==============================================================================
# vcptcore-dev environment — the vcptcore DEV instance.
# MINIMAL PROFILE: it exists so the kb can name this stand (128 evidence items
# were recorded on it before it had a profile) and read its build. It carries no
# store, persona or seed values yet, so `TEST_ENV=vcptcore_dev npm run env:check`
# reports the missing core vars until someone provisions it for test runs.
# Committed; URLs/identifiers only — secrets live in .env.local
# ==============================================================================

# --- Risk gate ---------------------------------------------------------------
ENV_RISK=test

# --- Knowledge base -----------------------------------------------------------
# The name the kb records observations on this stand under. Every alias of this
# profile (env name, BACK_URL / FRONT_URL host) is mapped onto it at the write door
# (scripts/kb/core/stands.mjs). Changing it renames the stand in new evidence only.
KB_STAND=vcptcore_dev

# --- Application URLs --------------------------------------------------------
FRONT_URL=https://vcptcore-dev-storefront.govirto.com
BACK_URL=https://vcptcore-dev.govirto.com
