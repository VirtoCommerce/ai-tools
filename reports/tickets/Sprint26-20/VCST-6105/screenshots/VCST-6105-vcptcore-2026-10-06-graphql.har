  valueDisplayOrder\\n  propertyType\\n  hidden\\n  propertyValueType\\n  label\\n  displayOrder\\n  __typename\\n}\\n\\nfragment availabilityData on AvailabilityData {\\n  isActive\\n  isAvailable\\n  isBuyable\\n  isInStock\\n  availableQuantity\\n  __typename\\n}\"}","params":[]}},"response":{"status":200,"statusText":"","httpVersion":"h3","cookies":[],"headers":[{"name":"alt-svc","value":"h3=\":443\"; ma=86400"},{"name":"cf-cache-status","value":"DYNAMIC"},{"name":"cf-ray","value":"a464aaadde7ac242-VIE"},{"name":"content-security-policy","value":"object-src 'none'; form-action 'self'; frame-ancestors 'self'"},{"name":"content-type","value":"application/graphql-response+json; charset=utf-8"},{"name":"cross-origin-embedder-policy","value":"unsafe-none"},{"name":"cross-origin-opener-policy","value":"unsafe-none"},{"name":"cross-origin-resource-policy","value":"cross-origin"},{"name":"date","value":"Tue, 06 Oct 2026 12:28:35 GMT"},{"name":"nel","value":"{\"report_to\":\"cf-nel\",\"success_fraction\":0.0,\"max_age\":604800}"},{"name":"priority","value":"u=1,i"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"report-to","value":"{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=d2BUu4wgbnVGVPAcTHzMg9TpFOTYJe25%2BFaiWCsLpIrmmGDqNdyKjF51I3azD2oBv9e3FWk4sTyeXCNGWk7wuzXi0ozxqswocs5VuKQMTKXH1J9ucWmMgUOURqmatFKsZQrUJjLWLAidqdhv5qmx8eav9Dyv\"}]}"},{"name":"request-context","value":"appId=cid-v1:0ab21c6a-c538-4e49-8bf8-92459beb4e45"},{"name":"server","value":"cloudflare"},{"name":"server-timing","value":"cfExtPri"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"DENY"}],"content":{"size":1536,"mimeType":"application/graphql-response+json; charset=utf-8","compression":0,"text":"{\"data\":{\"wishlist\":{\"name\":\"AGENT-TEST-6105-B6c-toast4-950-1791288755220\",\"descripti