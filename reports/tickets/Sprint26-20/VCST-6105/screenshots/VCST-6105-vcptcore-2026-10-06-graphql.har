/15180359-7-9BC8C9F.jpg\",\"__typename\":\"ImageType\"},{\"url\":\"https://qademovc3.blob.core.windows.net/catalog/c1959/PIC-96665767/15180359-8-2133283.jpg\",\"__typename\":\"ImageType\"},{\"url\":\"https://qademovc3.blob.core.windows.net/catalog/c1959/PIC-96665767/15180359-9-DE035AF.jpg\",\"__typename\":\"ImageType\"},{\"url\":\"https://qademovc3.blob.core.windows.net/catalog/c1959/PIC-96665767/15180359-10-712C6FC.jpg\",\"__typename\":\"ImageType\"},{\"url\":\"https://qademovc3.blob.core.windows.net/catalog/c1959/PIC-96665767/15180359-11-3809876.jpg\",\"__typename\":\"ImageType\"},{\"url\":\"https://qademovc3.blob.core.windows.net/catalog/c1959/PIC-96665767/15180359-12-D84EE33.jpg\",\"__typename\":\"ImageType\"},{\"url\":\"https://qademovc3.blob.core.windows.net/catalog/c1959/PIC-96665767/15180359-13-C3B52FD.jpg\",\"__typename\":\"ImageType\"}],\"description\":{\"content\":\"ST. JAMES - A Premier Building in a Premier Location\\n\\n101/350 St Kilda Road for Sale\\nConveniently located opposite the Royal Botanic Gardens, this 10th floor North-East corner residence features spectacular views of the city skyline, the Shrine of Remembrance, and the Royal Botanic Gardens.\\n\\nOffering an abundance of natural light from every room and stunning European oak timber floors, high ceilings, entrance hall, spacious open plan living and dining, large undercover balcony and sparkling marble finishes in the kitchen and bathrooms.\\n\\nComprising 3 bedrooms, 2 bathrooms (main bedroom with wardrobes and marble ensuite), powder room, separate laundry, reverse-cycle air-conditioning, 2 side-by-side car parks and lock-up storeroom.\\n\\nResidents' facilities are first class and include 24/7 Concierge and Security, Conference Room and Business Centre, indoor swimming pool and gym, sauna, steam room, massage room and a fabulous refurbished Residents' Lounge - perfect for private functions and landscaped Alfresco terrace.\\n\\nSt James is brilliantly located within easy reach of Melbourne's bay-side beaches, Albert Park village, The Arts Centre precinct (concert halls, theatres, galleries), The CBD, MCG, Prahran and South Melbourne Markets, South Yarra and Toorak shopping precincts with their many boutique shops, cafes and restaurants and top schools, universities, sporting facilities and hospitals.\",\"__typename\":\"DescriptionType\"},\"availabilityData\":{\"isActive\":true,\"isAvailable\":true,\"isBuyable\":true,\"isInStock\":true,\"availableQuantity\":0,\"__typename\":\"AvailabilityData\"},\"price\":{\"currency\":\"USD\",\"actual\":{\"amount\":2850000.00,\"formattedAmount\":\"$2,850,000.00\",\"formattedAmountWithoutCurrency\":\"2,850,000.00\",\"currency\":{\"code\":\"USD\",\"symbol\":\"$\",\"__typename\":\"CurrencyType\"},\"__typename\":\"MoneyType\"},\"discountAmount\":{\"amount\":0.0,\"formattedAmount\":\"$0.00\",\"__typename\":\"MoneyType\"},\"sale\":{\"amount\":2850000.00,\"formattedAmount\":\"$2,850,000.00\",\"__typename\":\"MoneyType\"},\"list\":{\"amount\":2850000.00,\"formattedAmount\":\"$2,850,000.00\",\"formattedAmountWithoutCurrency\":\"2,850,000.00\",\"currency\":{\"code\":\"USD\",\"symbol\":\"$\",\"__typename\":\"CurrencyType\"},\"__typename\":\"MoneyType\"},\"discountPercent\":0.0,\"__typename\":\"PriceType\"},\"minVariationPrice\":{\"actual\":{\"amount\":2850000.0,\"formattedAmount\":\"$2,850,000.00\",\"formattedAmountWithoutCurrency\":\"2,850,000.00\",\"currency\":{\"code\":\"USD\",\"symbol\":\"$\",\"__typename\":\"CurrencyType\"},\"__typename\":\"MoneyType\"},\"__typename\":\"PriceType\"},\"properties\":[{\"group\":null,\"name\":\"Address\",\"colorCode\":null,\"value\":\"101/350 St Kilda Road, Melbourne, VIC 3004\",\"valueDisplayOrder\":null,\"propertyType\":\"PRODUCT\",\"hidden\":false,\"propertyValueType\":\"SHORT_TEXT\",\"label\":\"Address\",\"displayOrder\":null,\"__typename\":\"Property\"},{\"group\":null,\"name\":\"Bathrooms\",\"colorCode\":null,\"value\":2,\"valueDisplayOrder\":null,\"propertyType\":\"PRODUCT\",\"hidden\":false,\"propertyValueType\":\"INTEGER\",\"label\":\"Bathrooms\",\"displayOrder\":null,\"__typename\":\"Property\"},{\"group\":null,\"name\":\"Bedrooms\",\"colorCode\":null,\"value\":3,\"valueDisplayOrder\":null,\"propertyType\":\"PRODUCT\",\"hidden\":false,\"propertyValueType\":\"INTEGER\",\"label\":\"Bedrooms\",\"displayOrder\":null,\"__typename\":\"Property\"},{\"group\":null,\"name\":\"Land_size\",\"colorCode\":null,\"value\":null,\"valueDisplayOrder\":null,\"propertyType\":\"PRODUCT\",\"hidden\":false,\"propertyValueType\":\"SHORT_TEXT\",\"label\":\"Land size\",\"displayOrder\":null,\"__typename\":\"Property\"},{\"group\":null,\"name\":\"Parking\",\"colorCode\":null,\"value\":2,\"valueDisplayOrder\":null,\"propertyType\":\"PRODUCT\",\"hidden\":false,\"propertyValueType\":\"INTEGER\",\"label\":\"Parking\",\"displayOrder\":null,\"__typename\":\"Property\"},{\"group\":null,\"name\":\"Property_Location\",\"colorCode\":null,\"value\":\"Melbourne\",\"valueDisplayOrder\":null,\"propertyType\":\"PRODUCT\",\"hidden\":false,\"propertyValueType\":\"SHORT_TEXT\",\"label\":\"Property Location\",\"displayOrder\":null,\"__typename\":\"Property\"},{\"group\":null,\"name\":\"Property_type\",\"colorCode\":null,\"value\":\"Unit\",\"valueDisplayOrder\":null,\"propertyType\":\"PRODUCT\",\"hidden\":false,\"propertyValueType\":\"SHORT_TEXT\",\"label\":\"Property type\",\"displayOrder\":null,\"__typename\":\"Property\"},{\"group\":null,\"name\":\"Type\",\"colorCode\":null,\"value\":\"Buy\",\"valueDisplayOrder\":null,\"propertyType\":\"PRODUCT\",\"hidden\":false,\"propertyValueType\":\"SHORT_TEXT\",\"label\":\"Type\",\"displayOrder\":null,\"__typename\":\"Property\"}],\"rating\":null,\"breadcrumbs\":[{\"itemId\":\"fc596540864a41bf8ab78734ee7353a3\",\"title\":\"Catalog\",\"typeName\":\"Catalog\",\"__typename\":\"Breadcrumb\"},{\"itemId\":\"a5ba165f-2a9c-4783-8d94-b849e0cf0440\",\"title\":\"Rental home\",\"typeName\":\"Category\",\"__typename\":\"Breadcrumb\"},{\"itemId\":\"97865e54-7