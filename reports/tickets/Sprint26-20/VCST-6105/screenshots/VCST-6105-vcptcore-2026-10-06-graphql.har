Fields\\n      __typename\\n    }\\n    slugInfo {\\n      ...slugInfoResponseTypeFields\\n      __typename\\n    }\\n    whiteLabelingSettings {\\n      ...whiteLabelingFields\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment organizationFields on Organization {\\n  id\\n  name\\n  isLockedForCurrentUser\\n  __typename\\n}\\n\\nfragment allLanguageFields on LanguageType {\\n  isInvariant\\n  cultureName\\n  nativeName\\n  threeLetterLanguageName\\n  twoLetterLanguageName\\n  twoLetterRegionName\\n  threeLetterRegionName\\n  __typename\\n}\\n\\nfragment allCurrencyFields on CurrencyType {\\n  code\\n  symbol\\n  exchangeRate\\n  customFormatting\\n  englishName\\n  cultureName\\n  __typename\\n}\\n\\nfragment userTypeFields on UserType {\\n  id\\n  memberId\\n  userName\\n  email\\n  emailConfirmed\\n  photoUrl\\n  phoneNumber\\n  permissions\\n  isAdministrator\\n  passwordExpired\\n  passwordExpiryInDays\\n  forcePasswordChange\\n  lockedState\\n  contact {\\n    id\\n    firstName\\n    lastName\\n    fullName\\n    organizationId\\n    defaultLanguage\\n    currencyCode\\n    selectedAddressId\\n    organization {\\n      ...organizationFields\\n      __typename\\n    }\\n    organizations {\\n      totalCount\\n      __typename\\n    }\\n    __typename\\n  }\\n  operator {\\n    userName\\n    contact {\\n      fullName\\n      __typename\\n    }\\n    __typename\\n  }\\n  roles {\\n    name\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment storeResponseTypeFields on StoreResponseType {\\n  storeId\\n  storeName\\n  catalogId\\n  storeUrl\\n  defaultLanguage {\\n    ...allLanguageFields\\n    __typename\\n  }\\n  availableLanguages {\\n    ...allLanguageFields\\n    __typename\\n  }\\n  defaultCurrency {\\n    ...allCurrencyFields\\n    __typename\\n  }\\n  availableCurrencies {\\n    ...allCurrencyFields\\n    __typename\\n  }\\n  settings {\\n    authenticationTypes\\n    subscriptionEnabled\\n    taxCalculationEnabled\\n    anonymousUsersAllowed\\n    environmentName\\n    emailVerificationEnabled\\n    emailVerificationRequired\\n    createAnonymousOrderEnabled\\n    seoLinkType\\n    defaultSelectedForCheckout\\n    passwordRequirements {\\n      requireLowercase\\n      requireUppercase\\n      requireDigit\\n      requiredLength\\n      requiredUniqueChars\\n      requireNonAlphanumeric\\n      __typename\\n    }\\n    modules {\\n      moduleId\\n      settings {\\n        name\\n        value\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment slugInfoResponseTypeFields on SlugInfoResponseType {\\n  entityInfo {\\n    id\\n    isActive\\n    languageCode\\n    objectId\\n    objectType\\n    semanticUrl\\n    metaDescription\\n    metaKeywords\\n    pageTitle\\n    outline\\n    __typename\\n  }\\n  redirectUrl\\n  __typename\\n}\\n\\nfragment whiteLabelingFields on WhiteLabelingSettingsType {\\n  logoUrl\\n  secondaryLogoUrl\\n  themePresetName\\n  isOrganizationLogoUploaded\\n  favicons {\\n    rel\\n    type\\n    sizes\\n    href\\n    __typename\\n  }\\n  mainMenuLinks {\\n    title\\n    url\\n    priority\\n    childItems {\\n      title\\n      url\\n      priority\\n      __typename\\n    }\\n    __typename\\n  }\\n  footerLinks {\\n    title\\n    url\\n    priority\\n    childItems {\\n      title\\n      url\\n      priority\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\"}","params":[]}},"response":{"status":200,"statusText":"","httpVersion":"h3","cookies":[],"headers":[{"name":"alt-svc","value":"h3=\":443\"; ma=86400"},{"name":"cf-cache-status","value":"DYNAMIC"},{"name":"cf-ray","value":"a464a5a63b1611d5-VIE"},{"name":"content-security-policy","value":"object-src 'none'; form-action 'self'; frame-ancestors 'self'"},{"name":"content-type","value":"application/graphql-response+json; charset=utf-8"},{"name":"cross-origin-embedder-policy","value":"unsafe-none"},{"name":"cross-origin-opener-policy