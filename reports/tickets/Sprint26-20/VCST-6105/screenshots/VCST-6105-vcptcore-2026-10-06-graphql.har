ssId\\n    organization {\\n      ...organizationFields\\n      __typename\\n    }\\n    organizations {\\n      totalCount\\n      __typename\\n    }\\n    __typename\\n  }\\n  operator {\\n    userName\\n    contact {\\n      fullName\\n      __typename\\n    }\\n    __typename\\n  }\\n  roles {\\n    name\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment storeResponseTypeFields on StoreResponseType {\\n  storeId\\n  storeName\\n  catalogId\\n  storeUrl\\n  defaultLanguage {\\n    ...allLanguageFields\\n    __typename\\n  }\\n  availableLanguages {\\n    ...allLanguageFields\\n    __typename\\n  }\\n  defaultCurrency {\\n    ...allCurrencyFields\\n    __typename\\n  }\\n  availableCurrencies {\\n    ...allCurrencyFields\\n    __typename\\n  }\\n  settings {\\n    authenticationTypes\\n    subscriptionEnabled\\n    taxCalculationEnabled\\n    anonymousUsersAllowed\\n    environmentName\\n    emailVerificationEnabled\\n    emailVerificationRequired\\n    createAnonymousOrderEnabled\\n    seoLinkType\\n    defaultSelectedForCheckout\\n    passwordRequirements {\\n      requireLowercase\\n      requireUppercase\\n      requireDigit\\n      requiredLength\\n      requiredUniqueChars\\n      requireNonAlphanumeric\\n      __typename\\n    }\\n    modules {\\n      moduleId\\n      settings {\\n        name\\n        value\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment slugInfoResponseTypeFields on SlugInfoResponseType {\\n  entityInfo {\\n    id\\n    isActive\\n    languageCode\\n    objectId\\n    objectType\\n    semanticUrl\\n    metaDescription\\n    metaKeywords\\n    pageTitle\\n    outline\\n    __typename\\n  }\\n  redirectUrl\\n  __typename\\n}\\n\\nfragment whiteLabelingFields on WhiteLabelingSettingsType {\\n  logoUrl\\n  secondaryLogoUrl\\n  themePresetName\\n  isOrganizationLogoUploaded\\n  favicons {\\n    rel\\n    type\\n    sizes\\n    href\\n    __typename\\n  }\\n  mainMenuLinks