erRegionName\\n  threeLetterRegionName\\n  __typename\\n}\\n\\nfragment allCurrencyFields on CurrencyType {\\n  code\\n  symbol\\n  exchangeRate\\n  customFormatting\\n  englishName\\n  cultureName\\n  __typename\\n}\\n\\nfragment userTypeFields on UserType {\\n  id\\n  memberId\\n  userName\\n  email\\n  emailConfirmed\\n  photoUrl\\n  phoneNumber\\n  permissions\\n  isAdministrator\\n  passwordExpired\\n  passwordExpiryInDays\\n  forcePasswordChange\\n  lockedState\\n  contact {\\n    id\\n    firstName\\n    lastName\\n    fullName\\n    organizationId\\n    defaultLanguage\\n    currencyCode\\n    selectedAddressId\\n    organization {\\n      ...organizationFields\\n      __typename\\n    }\\n    organizations {\\n      totalCount\\n      __typename\\n    }\\n    __typename\\n  }\\n  operator {\\n    userName\\n    contact {\\n      fullName\\n      __typename\\n    }\\n    __typename\\n  }\\n  roles {\\n    name\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment storeResponseTypeFields on StoreResponseType {\\n  storeId\\n  storeName\\n  catalogId\\n  storeUrl\\n  defaultLanguage {\\n    ...allLanguageFields\\n    __typename\\n  }\\n  availableLanguages {\\n    ...allLanguageFields\\n    __typename\\n  }\\n  defaultCurrency {\\n    ...allCurrencyFields\\n    __typename\\n  }\\n  availableCurrencies {\\n    ...allCurrencyFields\\n    __typename\\n  }\\n  settings {\\n    authenticationTypes\\n    subscriptionEnabled\\n    taxCalculationEnabled\\n    anonymousUsersAllowed\\n    environmentName\\n    emailVerificationEnabled\\n    emailVerificationRequired\\n    createAnonymousOrderEnabled\\n    seoLinkType\\n    defaultSelectedForCheckout\\n    passwordRequirements {\\n      requireLowercase\\n      requireUppercase\\n      requireDigit\\n      requiredLength\\n      requiredUniqueChars\\n      requireNonAlphanumeric\\n      __typename\\n    }\\n    modules {\\n      moduleId\\n      settings {\\n        name\\n        value\\n        __typename\\n      }\\