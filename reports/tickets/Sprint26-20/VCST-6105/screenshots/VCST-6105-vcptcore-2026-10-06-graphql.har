ename\\n    }\\n    __typename\\n  }\\n  roles {\\n    name\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment storeResponseTypeFields on StoreResponseType {\\n  storeId\\n  storeName\\n  catalogId\\n  storeUrl\\n  defaultLanguage {\\n    ...allLanguageFields\\n    __typename\\n  }\\n  availableLanguages {\\n    ...allLanguageFields\\n    __typename\\n  }\\n  defaultCurrency {\\n    ...allCurrencyFields\\n    __typename\\n  }\\n  availableCurrencies {\\n    ...allCurrencyFields\\n    __typename\\n  }\\n  settings {\\n    authenticationTypes\\n    subscriptionEnabled\\n    taxCalculationEnabled\\n    anonymousUsersAllowed\\n    environmentName\\n    emailVerificationEnabled\\n    emailVerificationRequired\\n    createAnonymousOrderEnabled\\n    seoLinkType\\n    defaultSelectedForCheckout\\n    passwordRequirements {\\n      requireLowercase\\n      requireUppercase\\n      requireDigit\\n      requiredLength\\n      requiredUniqueChars\\n      requireNonAlphanumeric\\n      __typename\\n    }\\n    modules {\\n      moduleId\\n      settings {\\n        name\\n        value\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment slugInfoResponseTypeFields on SlugInfoResponseType {\\n  entityInfo {\\n    id\\n    isActive\\n    languageCode\\n    objectId\\n    objectType\\n    semanticUrl\\n    metaDescription\\n    metaKeywords\\n    pageTitle\\n    outline\\n    __typename\\n  }\\n  redirectUrl\\n  __typename\\n}\\n\\nfragment whiteLabelingFields on WhiteLabelingSettingsType {\\n  logoUrl\\n  secondaryLogoUrl\\n  themePresetName\\n  isOrganizationLogoUploaded\\n  favicons {\\n    rel\\n    type\\n    sizes\\n    href\\n    __typename\\n  }\\n  mainMenuLinks {\\n    title\\n    url\\n    priority\\n    childItems {\\n      title\\n      url\\n      priority\\n      __typename\\n    }\\n    __typename\\n  }\\n  footerLinks {\\n    title\\n    url\\n    priority\\n    childItems {\\n      title\\n      url\\n      priority\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\"}","params":[]}},"response":{"status":200,"statusText":"","httpVersion":"h3","cookies":[],"headers":[{"name":"alt-svc","value":"h3=\":443\"; ma=86400"},{"name":"cf-cache-status","value":"DYNAMIC"},{"name":"cf-ray","value":"a46496d11cc35a68-VIE"},{"name":"content-security-policy","value":"object-src 'none'; form-action 'self'; frame-ancestors 'self'"},{"name":"content-type","value":"application/graphql-response+json; charset=utf-8"},{"name":"cross-origin-embedder-policy","value":"unsafe-none"},{"name":"cross-origin-opener-policy","value":"unsafe-none"},{"name":"cross-origin-resource-policy","value":"cross-origin"},{"name":"date","value":"Tue, 06 Oct 2026 12:15:01 GMT"},{"name":"nel","value":"{\"report_to\":\"cf-nel\",\"success_fraction\":0.0,\"max_age\":604800}"},{"name":"priority","value":"u=1,i"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"report-to","value":"{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=3dSEGvw3JGRL90RoFUd5O%2FeRMG7zyt39wFHfxy3KFGm%2BG61u%2BQZD%2Bemu3nCPf2gAePZXkkriy%2BCGdgwtnDKLzSW8nuOAh%2F50qRJe0dGRLZfjJ32HKSzCYBvncy7MvYXMw56s2tq5YF7W1XsXxNo%2F%2F7IxPeWi\"}]}"},{"name":"request-context","value":"appId=cid-v1:0ab21c6a-c538-4e49-8bf8-92459beb4e45"},{"name":"server","value":"cloudflare"},{"name":"server-timing","value":"cfExtPri"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"DENY"}],"content":{"size":21648,"mimeType":"application/graphql-response+json; charset=utf-8","compression":0,"text":"{\"data\":{\"pageContext\":{\"user\":{\"id\":\"96a5c3a7-a462-4055-9158-0f4d48c1b594\",\"memberId\":\"6bf9b1d0-6d34-4ada-858c-bc3fb5e785b4\",\"userName\":\"agent-test-sr-primary@example.com\",\"email\":\"agent-test-sr-primary@example.com\",\"emailConfirmed\":