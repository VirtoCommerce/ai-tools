name\\n        }\\n        __typename\\n      }\\n      hasVariations\\n      slug\\n      outline\\n      imgSrc\\n      images @include(if: $withImages) {\\n        url\\n        __typename\\n      }\\n      description(type: \\\"QuickReview\\\") {\\n        content\\n        __typename\\n      }\\n      availabilityData {\\n        ...availabilityData\\n        __typename\\n      }\\n      price {\\n        currency\\n        actual {\\n          ...money\\n          __typename\\n        }\\n        discountAmount {\\n          amount\\n          formattedAmount\\n          __typename\\n        }\\n        sale {\\n          amount\\n          formattedAmount\\n          __typename\\n        }\\n        list {\\n          ...money\\n          __typename\\n        }\\n        discountPercent\\n        __typename\\n      }\\n      minVariationPrice {\\n        actual {\\n          ...money\\n          __typename\\n        }\\n        __typename\\n      }\\n      properties {\\n        ...property\\n        __typename\\n      }\\n      rating {\\n        ...rating\\n        __typename\\n      }\\n      breadcrumbs {\\n        itemId\\n        title\\n        typeName\\n        __typename\\n      }\\n      __typename\\n    }\\n    term_facets @include(if: $withFacets) {\\n      name\\n      label\\n      terms {\\n        label\\n        term\\n        count\\n        isSelected\\n        __typename\\n      }\\n      __typename\\n    }\\n    range_facets @include(if: $withFacets) {\\n      ...rangeFacet\\n      __typename\\n    }\\n    filters @include(if: $withFacets) {\\n      ...filter\\n      __typename\\n    }\\n    sortings @include(if: $withFacets) {\\n      id\\n      name\\n      isDefault\\n      selected\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment money on MoneyType {\\n  amount\\n  formattedAmount\\n  formattedAmountWithoutCurrency\\n  currency {\\n    ...currency\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment currency on CurrencyType {\\n  code\\n  symbol\\n  __typename\\n}\\n\\nfragment rating on Rating {\\n  value\\n  reviewCount\\n  __typename\\n}\\n\\nfragment property on Property {\\n  group {\\n    id\\n    name\\n    displayOrder\\n    description\\n    __typename\\n  }\\n  name\\n  colorCode\\n  value\\n  valueDisplayOrder\\n  propertyType\\n  hidden\\n  propertyValueType\\n  label\\n  displayOrder\\n  __typename\\n}\\n\\nfragment availabilityData on AvailabilityData {\\n  isActive\\n  isAvailable\\n  isBuyable\\n  isInStock\\n  availableQuantity\\n  __typename\\n}\\n\\nfragment rangeFacet on RangeFacet {\\n  name\\n  label\\n  ranges {\\n    label\\n    count\\n    from\\n    to\\n    includeFrom\\n    includeTo\\n    isSelected\\n    __typename\\n  }\\n  statistics {\\n    min\\n    max\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment filter on SearchProductFilterResult {\\n  name\\n  label\\n  filterType\\n  isGenerated\\n  rangeValues {\\n    includeLowerBound\\n    includeUpperBound\\n    lower\\n    upper\\n    __typename\\n  }\\n  termValues {\\n    label\\n    value\\n    __typename\\n  }\\n  __typename\\n}\"}","params":[]}},"response":{"status":200,"statusText":"","httpVersion":"h3","cookies":[],"headers":[{"name":"alt-svc","value":"h3=\":443\"; ma=86400"},{"name":"cf-cache-status","value":"DYNAMIC"},{"name":"cf-ray","value":"a46494aa0d7ea464-VIE"},{"name":"content-security-policy","value":"object-src 'none'; form-action 'self'; frame-ancestors 'self'"},{"name":"content-type","value":"application/graphql-response+json; charset=utf-8"},{"name":"cross-origin-embedder-policy","value":"unsafe-none"},{"name":"cross-origin-opener-policy","value":"unsafe-none"},{"name":"cross-origin-resource-policy","value":"cross-origin"},{"name":"date","value":"Tue, 06 Oct 2026 12:13:39 GMT"},{"name":"nel","value":"{\"report_to\":\"cf-nel\",\"success_fraction\":0.0,\"max_age\":604800}"},{"name":"priority","value":"u=1,i"},{"name":"referrer-policy","value":"strict-origin-when-cross