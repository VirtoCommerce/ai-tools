# ==============================================================================
# vcst-dev environment — the dev stand of vcst
# Activate: TEST_ENV=vcst_dev npm run env:check  (or npm run env:use -- vcst_dev)
# Committed; URLs/identifiers only — test-account logins and passwords live in
# test-accounts.local.json (envs.vcst_dev); tokens in vc-secrets / .env.local
# Deploy branch for /qa-env-upgrade: vc-deploy-dev@vcst-dev (derived from the env name, _ -> -).
# ==============================================================================

STOREFRONT_PROFILE=b2b
ENV_RISK=test
MODULES_ENABLED=
PAYMENT_PROCESSORS_ENABLED=

# --- Knowledge base -----------------------------------------------------------
KB_STAND=vcst_dev

# --- Application URLs --------------------------------------------------------
FRONT_URL=https://vcst-dev-storefront.govirto.com
BACK_URL=https://vcst-dev.govirto.com
ADMIN_URL=https://vcst-dev.govirto.com
ADMIN_SHELL_URL=https://vcst-dev.govirto.com/apps/admin-shell/#/login
STORYBOOK_URL=https://vcst-dev-storybook.govirto.com
STORYBOOK_DEV_URL=https://vcst-dev-storybook.govirto.com

# --- Store configuration -----------------------------------------------------
STORE_ID=B2B-store
STOREFRONT_DOMAIN=vcst-dev-storefront.govirto.com
# Real GUID of the USER account on this environment (= @td(ACME_BUYER.platform_id)) — session-hint userId arg
TEST_USER_ID=fa2730b5-fe67-4420-85ec-dc98e2917f07

# --- Test accounts: logins and passwords are in test-accounts.local.json (npm run creds:check) ---

# --- Fixtures (seeded by seed --skip-optional + seed:configurable + seed:promotions, 2026-11-18) ---
VALID_COUPON_CODE=QA
# Permanent OOS fixture — test-products.csv PROD-101, @td(PROD_OOS.sku)
OOS_SKU=QA-OOS-001
# Near-limit stock fixture (stock 5) — PROD-102, @td(PROD_LOW_STOCK.sku)
LOW_STOCK_SKU=QA-LOW-001
# MOQ / pack-size 6 fixture — PROD-103, @td(PROD_PACK_SIZE.sku)
PACK_SIZE_SKU=QA-PACK-001
# Tier-priced fixture (1+ / 10+ / 20+ qty breaks) — PROD-104, @td(PROD_TIER_PRICED.sku)
TIER_PRICED_SKU=QA-TIER-001
# Configurable fixture CFG-013 (AGENT-TEST-Config-Laptop) — @td(CFG_LAPTOP)
CONFIGURABLE_SKU=AGENT-TEST-CFG-013
# Suite 009 references: TEST_SKU (variation default), TEST_SKU_CONFIGURABLE
# (configurable default), TEST_SKU_VARIANTS (multi-attribute variations).
# vcst's XKC-38084072 is not in this catalog; 355391340 (Dark Blue Chiffon Belted Dress) is the
# equivalent here: 5 buyable variations over Colour/Size/Style, in stock (xAPI, 2026-11-18).
TEST_SKU=355391340
TEST_SKU_CONFIGURABLE=AGENT-TEST-CFG-013
TEST_SKU_VARIANTS=355391340
# Not on this stand yet (2026-11-18): ORDER_WITH_DISCONTINUED_ITEM (seed:edge-cases was not run).
# SR_NOLOCALE_CULTURE is left unset: vcst's value (el) is not among this storefront's cultures.

# --- Tracker --------------------------------------------------------------------
JIRA_BASE_URL=https://virtocommerce.atlassian.net
JIRA_PROJECT_KEY=VCST

# --- Azure Application Insights — not configured for this stand yet ---------------
