node_modules
.env
.env.backup
.env.*.backup
# Layered env files — secrets stay local, per-env scaffolds are committed
.env.local
.env.*.local
# Per-env Playwright MCP secrets (.env.playwright.<env>) hold passwords — never committed
/.env.playwright.*
!.env.defaults
!.env.vcst
!.env.vcptcore
!.env.virtostart
# Per-developer / per-team default env selector (set once per checkout, not shared).
# Format + onboarding documented in .env.example.
.env.test-env
.playwright-mcp/
.vscode/
.idea/
test-results/
results/
# settings.json is ignored tree-wide by default (IDE/tool-local config); the
# project's own shared config is the one deliberate exception.
settings.json
!/.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
.mcp.json
scripts/.graphql-schema.cache.json
scripts/.graphql-schema.*.cache.json
# A ticket run's own schema caches (scripts/lib/run-dir.mjs) when its run folder sits under reports/tickets/
reports/tickets/**/.graphql-schema*.cache.json
# Ad-hoc/run-less graphql-runner evidence (no --run-id) — scratch, not tied to a run
scripts/.graphql-evidence/

# Newman/Postman run artifacts — carry live env credentials + OAuth tokens. Never commit.
.newman-run/

# Deployment profile (project-init) — client-specific, may carry repo topology.
# The committed project-profile.example.json is the template; the real one is local.
project-profile.json

# === Run artifacts are never committed (VCST-6394) ===
# Screenshots, GIFs, video, HAR and Playwright traces are evidence of ONE run: the durable copy of a
# screenshot a reader needs is the tracker attachment (reports-policy.md §5), never the repo. They
# were 677 MB of the repo's history. Ignored everywhere, so no new run folder needs its own rule.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.mp4
*.webm
*.har
*.zip
*.trace
# ...EXCEPT seeder input: test-data/ holds the images, videos and documents the seeders upload and
# the td:validate guards check (barcodes, brands, category images, white-labeling, uploads).
!test-data/**/*.png
!test-data/**/*.jpg
!test-data/**/*.jpeg
!test-data/**/*.JPg
!test-data/**/*.gif
!test-data/**/*.webp
!test-data/**/*.mp4
!test-data/**/*.zip

# Per-FAIL failure traces (network + parsed stack traces) — disposable evidence
# referenced from the report; may carry redacted-but-sensitive bodies, and this
# repo is public, so never commit them. The `*` run-dir segment covers BOTH
# regression (REG-*) and smoke (SMOKE-*) runs — both write to reports/regression/.
reports/regression/*/traces/*.json
vc/shared/reports/regression/*/traces/*.json

# Playwright MCP accessibility snapshots — dropped at repo root by browser MCPs
# during exploratory sessions. Transient working state, not deliverables.
# (No tracked YAML at repo root, so the bare-yml pattern is safe.)
/*.yml
/*.yaml

# Ad-hoc investigation scratch — one-off probe scripts, API dumps, downloaded
# build bundles and run-scoped working files. Disposable by construction: each
# file's value lives in the run that produced it, and whatever must survive
# belongs in a suite CSV, a seeder, or a report. Ignored because these routinely
# hold live tokens (a /connect/token response saved next to the probe that used
# it), and this repo is public — an untracked .scratch/ rides along on `git add -A`.
.scratch/

# Local environment (qa-local-env / start-local) — Docker checkout + generated
# manifest are transient working state, never committed.
.local-env/

# localhost alias override — auto-generated per fresh-DB seed (IDs drift each provision).
test-data/aliases.localhost.json

# NUKE build-tool working dir (transient build logs / temp from local-env provisioning)
.nuke/

# Self-diagnostics telemetry (Tier A collector) — per-session jsonl + state,
# written under the project output root; transient, never committed (VCST-5475)
.vc-fix/
.kb-harvest/

# vc-perf load/trace run artifacts (k6 summaries, counters CSV, .nettrace) — heavy,
# machine-specific, regenerated per run; kept out of the plugin install dir so they
# survive plugin updates (perf-loadtest RESULTS_DIR)
.vc-perf/

# Auto-fix pipeline — cloned product-repo source is transient working state
.fix-workspace/
# vs. DESIGN axis — user-supplied local copies of Claude Design projects, one folder per project uuid
.design-source/
# Auto-fix module discovery + dependency-graph cache (rebuilt from gh on TTL)
plugins/vc-fix/skills/qa-fix-routing/.module-registry.cache.json

# Scheduled test-case staleness audit (ci/run-suite-audit.ts). Entirely ephemeral:
# .claude/rules/reports.md has NO report category for a test-case review, so the
# audit narrative ships in the PR BODY and the only durable artifact is the CSV
# diff itself. Everything under here is pipeline working data (the agent
# transcript, the generated PR body, the commit message, summary.json).
reports/suite-audit/

# Online monitoring (App Insights) — fingerprint dedup state is local working state, not a report.
reports/monitoring/.seen-fingerprints.json

# Regression run artifacts are ephemeral local working state (screenshots, HARs, traces,
# resolved CSVs, per-suite results) — they only ever exist on whoever ran them.
# NOTE the trailing `/*`: git cannot re-include a file whose PARENT DIRECTORY is excluded, so
# the bare `reports/regression` this replaced made the negations below dead lines.
reports/regression/*
# ...EXCEPT the two rolling history files. These are small, append-only, 90-day-windowed and
# carry no evidence — and without them `scripts/regression/compute-metrics.ts` is starved:
# `appendToHistory` / `npm run triage:history` DO write them, but the whole directory was
# ignored and the CI container is ephemeral, so nothing ever survived a run. Its flaky rule
# (n >= 4 && crossings >= 3) could therefore never fire. Un-ignoring them is half the fix; the
# other half is the workflow restoring and committing them across runs.
!reports/regression/history.json
!reports/regression/history-ci-runs.json
# test-run-status.json is deliberately tracked (the interactive run interlock + the
# reap-stalled-run backstop read it), so name it explicitly rather than relying on the fact
# that an already-tracked file ignores .gitignore.
!reports/regression/test-run-status.json
# Seed run results — disposable local working state. The modular seed-*.mjs seeders no longer
# write these (runtime GUIDs now go to test-data/aliases.{env}.json); only seed-test-data.js's
# teardown-recovery dump remains. Recursive so nested dumps never get committed again.
test-data/**/_seed-results*.json
test-data/_seed-results*.json
# Seed-freshness marker (mtime + profile) for the regression reuse-skip check — local state
test-data/b2b/.seed-fingerprint.json

# vc-fix plugin self-diagnosis working report — may reference client identifiers /
# session context; kept local, never committed to the public upstream (§2a containment).
reports/vc-fix-plugin-diagnosis.md

# Serena (semantic code navigation): the shared .serena/project.yml + .serena/.gitignore
# ARE committed so every teammate gets the same project config. The machine-specific parts
# (cache/, logs/, project.local.yml) are excluded by .serena/.gitignore itself.

# === vc-fix (/project-init) — browser evidence landing zone ===
# The Playwright MCP servers write raw captures here; /qa-bug moves the ones it keeps
# into reports/bugs/screenshots/<bug-slug>/. Nothing here is evidence of record.
reports/bugs/screenshots/_incoming/

# Tracker comment ledger — one comment per ticket per run (tracker-ops.md §0)
.tracker-comments.json
# Session scratch (ad-hoc probes, staged CSV drafts, one-off scripts) — never committed
.scratch/

# Tracker attachments downloaded as run INPUT (not a report category, reports.md 1) — kept local
reports/tickets/**/attachments/

# Playwright spec run output
playwright-report/

# Playwright .spec output in a ticket run folder (<RUN_DIR>/specs/) — never committed.
reports/tickets/**/specs/

# /qa-investigate evidence packages in a ticket run folder (<RUN_DIR>/evidence[-<stamp>]/) — never committed.
reports/tickets/**/evidence*/

# Visual regression run output in a ticket run folder (<RUN_DIR>/visual/, ad-hoc <RUN_DIR>/pixel/) — never committed.
reports/tickets/**/visual/
reports/tickets/**/pixel/

# === vc-init (/project-init) — generated local config, never commit ===
# Per-machine onboarding output: the profile, env files (.env.local holds test-user passwords),
# the MCP config and the vc-secrets declarations. Tokens live in vc-secrets, not here. Never commit.
.claude/vc-secrets.local.json
