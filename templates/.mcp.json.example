{
  "//": "TEMPLATE — copy to .mcp.json (gitignored) and replace every <PLACEHOLDER>. Restart the MCP servers after editing. Windows uses `cmd /c npx`; on Linux/macOS drop the `cmd` + `/c` and call `npx` directly.",
  "//secrets": "Each Playwright server starts through scripts/lanes/playwright-lane.mjs, which reads every non-production env's login passwords from test-accounts.local.json (the one file every test account's login and password live in — templates/test-accounts.example.json) and hands them to Playwright MCP in memory: no --secrets file, nothing to sync. A suite signs in by typing the NAME with its env (browser_type text=ORG_USER_PASSWORD_VCPTCORE_DEV), MASTER_PASSWORD on a master stand; the MCP substitutes the value and redacts it. Login passwords ONLY — no token or API key ever reaches a lane. After a seeder adds an account or a password changes, reconnect the lanes in /mcp (npm run creds:check says which). npm run creds:migrate rewrites an older --secrets entry to this form. See .claude/knowledge/execution/browser-lanes.md and run-env.md.",
  "//isolation": "Each lane's --config sets an isolated browser (an in-memory profile per server), so parallel Claude Code sessions never share cookies or a profile lock. Keep it, or pass --isolated when a server has no config file.",
  "//output": "A run writes its screenshots into its run folder (QA_OUTPUT_DIR). When that folder is outside the project, add --allow-unrestricted-file-access to each Playwright server's args: a lane otherwise writes only inside its output folder and the project. The flag also lets the lane read local files and file:// URLs, so it is your call.",
  "mcpServers": {
    "playwright-chrome": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "-p",
        "@playwright/mcp@0.0.83",
        "node",
        "scripts/lanes/playwright-lane.mjs",
        "playwright-chrome",
        "@playwright/mcp@0.0.83",
        "--config",
        "config/mcp-playwright-chrome.config.json"
      ]
    },
    "playwright-firefox": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "-p",
        "@playwright/mcp@0.0.83",
        "node",
        "scripts/lanes/playwright-lane.mjs",
        "playwright-firefox",
        "@playwright/mcp@0.0.83",
        "--config",
        "config/mcp-playwright-firefox.config.json"
      ]
    },
    "playwright-edge": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "-p",
        "@playwright/mcp@0.0.83",
        "node",
        "scripts/lanes/playwright-lane.mjs",
        "playwright-edge",
        "@playwright/mcp@0.0.83",
        "--config",
        "config/mcp-playwright-edge.config.json"
      ]
    },
    "//mobile": "Touch/mobile lane — 390x844 portrait, isMobile + hasTouch, deviceScaleFactor 3. Several test cases' Preconditions require a touch viewport; without this server entry config/mcp-playwright-mobile.config.json is never loaded and the lane silently does not exist — the tell is that test-results/mobile/ never appears.",
    "playwright-mobile": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "-p",
        "@playwright/mcp@0.0.83",
        "node",
        "scripts/lanes/playwright-lane.mjs",
        "playwright-mobile",
        "@playwright/mcp@0.0.83",
        "--config",
        "config/mcp-playwright-mobile.config.json"
      ]
    },
    "Chrome DevTools": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "chrome-devtools-mcp@1.6.0",
        "--redactNetworkHeaders",
        "--viewport",
        "1920x1080",
        "--userDataDir",
        "<ABSOLUTE-PATH>/.chrome-devtools-mcp/vc-qa-profile"
      ],
      "env": {}
    },
    "postman": {
      "type": "http",
      "url": "https://mcp.postman.com/minimal",
      "headers": {
        "Authorization": "Bearer <POSTMAN_API_KEY>"
      }
    },
    "github": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<GITHUB_PERSONAL_ACCESS_TOKEN>"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "env": {
        "CONTEXT7_API_KEY": "<CONTEXT7_API_KEY>"
      }
    },
    "azure-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@azure/mcp@3.0.0-beta.32",
        "server",
        "start"
      ]
    },
    "figma-remote-mcp": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "env": {
        "FIGMA_API_KEY": "<FIGMA_API_KEY>"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    }
  }
}
