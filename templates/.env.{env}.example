# ==============================================================================
# Per-environment template (Bucket #2: per-env URLs/identifiers, committed, NO secrets)
# ==============================================================================
#
# QUICK START
#   1. Copy this file to .env.<your-env-name>   (name is arbitrary: [a-z0-9_]+)
#        cp .env.example .env.acme_staging
#   2. Fill in the values below for that environment.
#   3. Test-account logins AND passwords go in test-accounts.local.json, under
#      envs.<your-env-name> (shape: templates/test-accounts.example.json;
#      `npm run creds:check -- <your-env-name>` lists what the env still lacks).
#      Tokens and API keys go in vc-secrets, or .env.local until moved — see the
#      block at the bottom of this file.
#   4. Activate it for a single run:
#        PowerShell:  $env:TEST_ENV='acme_staging'; npm run env:check
#        bash/CI:     TEST_ENV=acme_staging npm run env:check
#
# MAKE IT YOUR TEAM/PERSONAL DEFAULT (so you don't pass TEST_ENV every time)
#   Create a gitignored .env.test-env file containing one line:
#        TEST_ENV=acme_staging
#   Resolution precedence (highest first), see scripts/lib/resolve-test-env.js:
#        1. process.env.TEST_ENV   (explicit shell/CI override — always wins)
#        2. .env.test-env          (this default)
#        3. 'vcst'                 (repo fallback)
#
# HOW THE LAYERS COMBINE (later overrides earlier), scripts/lib/env-layers.mjs:
#   .env.defaults -> .env.${TEST_ENV} -> .env.local -> QA_ENV_PATH folders
#   -> test-accounts.local.json -> PASSWORDS=master -> legacy .env
#
# Prefer the interactive scaffolder if you'd rather be prompted:
#   npx tsx bootstrap/install.ts --env=acme_staging      (/project-init)
# ==============================================================================

# --- Multi-env metadata (drives suite gating; see config.js) ------------------
# STOREFRONT_PROFILE: b2b | b2c | hybrid — gates which suites apply.
STOREFRONT_PROFILE=hybrid
# ENV_RISK: dev | test | staging | production — production blocks admin-write
# suites by default (safety-by-config, NOT by env name).
ENV_RISK=test
# MODULES_ENABLED: CSV of installed VC modules (empty = no filter).
MODULES_ENABLED=
# PAYMENT_PROCESSORS_ENABLED: CSV of processors you use
# (cybersource,skyflow,authorize-net,datatrance,stripe). Empty = no filter.
PAYMENT_PROCESSORS_ENABLED=
# JIRA_PROJECT_KEY: your JIRA project for bug filing.
JIRA_PROJECT_KEY=VCST

# --- Application URLs (REQUIRED) ---------------------------------------------
FRONT_URL=https://<your-storefront-host>
BACK_URL=https://<your-platform-host>
# Admin SPA / platform backend — usually same host as BACK_URL.
ADMIN_URL=https://<your-platform-host>
# Optional surfaces:
STORYBOOK_URL=
STORYBOOK_DEV_URL=

# --- Store configuration (REQUIRED: STORE_ID) --------------------------------
STORE_ID=B2B-store
STOREFRONT_DOMAIN=<your-storefront-host>
# Real GUID of USER_EMAIL on this env — used as a session userId hint (optional).
TEST_USER_ID=

# --- Test accounts — NOT here ------------------------------------------------
# Every test account's login AND password (ADMIN / ADMIN_EMAIL, USER_EMAIL,
# USER2_EMAIL, ORG_USER_EMAIL, IMPERSONATION_ADMIN_EMAIL, LOCKOUT_TEST_EMAIL,
# LOYALTY_*_USER_EMAIL … and their *_PASSWORD) lives in test-accounts.local.json,
# under envs.<this env>. A login or password left in a .env* file is reported by
# the loader as a leftover; `npm run creds:migrate` moves it.

# --- Seed fixture SKUs (optional — set after seeding test data) ---------------
VALID_COUPON_CODE=
OOS_SKU=
LOW_STOCK_SKU=
PACK_SIZE_SKU=
TIER_PRICED_SKU=
CONFIGURABLE_SKU=

# --- Integration identifiers -------------------------------------------------
# JIRA_EMAIL is NOT set here: it is a person's own login, the identity half of
# that person's JIRA_API_TOKEN. It goes in .env.local (the test-account store
# refuses it).

# --- Azure — online bug monitoring (optional) ---------------------------------
# The Azure subscription and resource group of this env's App Insights resources.
# The APPINSIGHTS_* settings themselves (App IDs, resource names, API keys) are
# in .env.local with this env's _<ENV> suffix — templates/.env.local.template.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# ==============================================================================
# SECRETS — do NOT put these here.
#   - Test-account logins + passwords: test-accounts.local.json (envs.<env>).
#   - Tracker / code-host tokens (Jira, GitHub, Azure DevOps): vc-secrets
#     (plugins/vc-secrets/README.md).
#   - App Insights (App IDs, resource names, API keys): .env.local, with this
#     env's _<ENV_NAME_UPPER> suffix — see templates/.env.local.template.
#
# Payment sandbox cards are shared defaults already set in .env.defaults — only
# override per-env if your sandbox is non-standard.
# ==============================================================================
