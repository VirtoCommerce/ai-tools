# ==============================================================================
# .env.local — per-machine settings and secrets (GITIGNORED, never commit)
# ==============================================================================
#
# config.js (the layered env loader, scripts/lib/env-layers.mjs) reads, in order:
#   1. .env.defaults          — cross-env constants (sandbox cards, etc.)
#   2. .env.${TEST_ENV}       — the env's own values (URLs, IDs, ENV_RISK)
#   3. .env.local             — THIS FILE: per-machine settings, and tokens / API keys
#                               not yet in vc-secrets
#   4. test-accounts.local.json — EVERY test account's login and password, every env
#                               (template: templates/test-accounts.example.json)
#
# NO test-account login or password goes in this file: the store above is the one
# place for them, and a seeder that creates an account records it there itself.
# A credential left here is named by the loader on every run; npm run creds:migrate
# moves it. Tokens and API keys belong in vc-secrets (plugins/vc-secrets/README.md).
#
# KEY_<ENV> pins still work for non-credential keys: when TEST_ENV=qa the loader
# promotes FOO_QA over FOO.

# --- API + Integration secrets (cross-env, usually one set per customer) -----
# These don't typically vary per env (one API key per provider account).
FIGMA_API_KEY=
POSTMAN_API_KEY=

# --- Atlassian / JIRA (for /qa-bug filing, /qa-status, /qa-test-plan) --------
# Typically configured at MCP level, not env vars. See docs/onboarding.md
# § Atlassian MCP setup.
# JIRA_PROJECT_KEY itself is per-env (lives in .env.${TEST_ENV}).

# --- BrowserStack (optional — only if you run cross-browser cloud tests) -----
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# --- Sanity QA project secrets (VCST-6475, suite 117 — npm run seed:sanity / sanity:webhook) ---
# The project id is NOT secret and lives in .env.<env> (SANITY_QA_PROJECT_ID). Leave empty where unused.
SANITY_QA_WRITE_TOKEN=
SANITY_QA_READ_TOKEN=
SANITY_QA_WEBHOOK_SECRET_0=
SANITY_QA_WEBHOOK_SECRET_1=
