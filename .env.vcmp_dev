# ==============================================================================
# vcmp-dev environment — the Marketplace DEV platform that hosts the Vendor Portal.
# The Vendor Portal is a vc-shell app, a SEPARATE PRODUCT from the storefront: the
# storefront suites, BL-UI invariants and Coffee-theme oracles do not apply to it
# (ticket-routing.md §5c, vc-bug-catalog.md §VC-SHELL).
# MINIMAL PROFILE: URLs + admin login only — no store, persona or seed values, so
# `TEST_ENV=vcmp_dev npm run env:check` reports the missing storefront vars.
# Committed; URLs/identifiers only — secrets live in .env.local
# (ADMIN_PASSWORD_VCMP_DEV) or .env.playwright.vcmp_dev
# ==============================================================================

# --- Risk gate ---------------------------------------------------------------
ENV_RISK=test

# --- Knowledge base -----------------------------------------------------------
KB_STAND=vcmp_dev

# --- Application URLs --------------------------------------------------------
BACK_URL=https://vcmp-dev.govirto.com
ADMIN_URL=https://vcmp-dev.govirto.com
VENDOR_PORTAL_URL=https://vcmp-dev.govirto.com/apps/vendor-portal/

# --- Storybook ----------------------------------------------------------------
# vc-shell's hosted Storybook (VirtoCommerce/vc-shell README; deployed by
# storybook-ci.yml on push to main / feat/redesign). It follows the vc-shell
# main branch, not the framework version the Vendor Portal build pins.
STORYBOOK_URL=https://vc-shell-storybook.govirto.com/
STORYBOOK_DEV_URL=https://vc-shell-storybook.govirto.com/

# --- Platform admin (password: ADMIN_PASSWORD_VCMP_DEV in .env.local) ----------
ADMIN=admin
ADMIN_EMAIL=admin
