# ==============================================================================
# vcptcore-qa1 environment — twin of vcptcore, QA1 instance.
# Carries the deployed vc-module-x-cart PR #122 artifact (configurationSection
# field on cart line items — VCST-5173). Verified live 2026-06-24:
#   GraphQL endpoint is {BACK_URL}/graphql (NOT /xapi/graphql).
#   CartConfigurationItemType.configurationSection present in deployed schema.
# Activate: TEST_ENV=vcptcore_qa1 npm run env:check
# Committed; URLs/identifiers only — test-account logins and passwords live in
# test-accounts.local.json (envs.vcptcore_qa1); tokens in vc-secrets / .env.local.
# ==============================================================================

# --- Risk gate ---------------------------------------------------------------
# QA env — admin-write suites + seeders allowed (not production).
ENV_RISK=test

# --- Knowledge base -----------------------------------------------------------
# The name the kb records observations on this stand under. Every alias of this
# profile (env name, BACK_URL / FRONT_URL host) is mapped onto it at the write door
# (scripts/kb/core/stands.mjs). Changing it renames the stand in new evidence only.
KB_STAND=vcptcore_qa1

# --- Application URLs --------------------------------------------------------
FRONT_URL=https://vcptcore-qa1-storefront.govirto.com
BACK_URL=https://vcptcore-qa1.govirto.com
ADMIN_SHELL_URL=https://vcptcore-qa1.govirto.com/apps/admin-shell/#/login
STORYBOOK_URL=https://vcptcore-qa1-storybook.govirto.com
STORYBOOK_DEV_URL=https://vcptcore-qa1-storybook.govirto.com

# --- Store configuration -----------------------------------------------------
# B2B-store is the standard slug on vcst + vcptcore; confirm via env:check.
STORE_ID=B2B-store
STOREFRONT_DOMAIN=vcptcore-qa1-storefront.govirto.com
# B2B-store catalog (B2B-mixed) + main fulfillment center (Chicago), from /api/stores.
# NOTE: seeded inventory lives on the Bristol FC (e5aea833…); it was added to the
# store's additionalFulfillmentCenterIds so seeded stock is buyable on the storefront.
STORE_CATALOG_ID=fc596540864a41bf8ab78734ee7353a3
MAIN_FULFILLMENT_CENTER_ID=142ba5568ae4454aad553ece41b9c3b5
# TODO: real GUID of the USER account on qa1 (discover via `me { id }` after first auth)
TEST_USER_ID=

ADMIN_URL=https://vcptcore-qa1.govirto.com

# --- Test accounts: logins and passwords are in test-accounts.local.json (npm run creds:check) ---
# Personas provisioned 2026-07-01 to mirror vcst (Contact + Customer security account,
# storeId=B2B-store), mapped to the seed:b2b fixture accounts as vcst maps them. Login and
# org context verified 2026-07-01 (/connect/token + storefront smoke).
ORG_USER_ID=
# LOYALTY_VIP_USER: NO seed:b2b equivalent on qa1 — the loyalty module is NOT installed, so a
# loyalty-VIP persona is not reproducible here. Absent until a loyalty-capable env exists.
# SALES_REP (VCST-5732 task fixtures) OWNS the AGENT-TEST-TASK rows: sales-rep tasks are private
# per rep account, so the fixture is isolated per REP ACCOUNT.
# Seed: TEST_ENV=vcptcore_qa1 npm run seed:sales-rep-tasks
# IMPERSONATION_ADMIN: NO seed:b2b equivalent — needs a userType=Manager account (seed:b2b does
# not create one). Absent until provisioned separately.

# --- Seed fixtures (provisioned via npm run seed:* — see test-data/_seed-results-*) -
VALID_COUPON_CODE=VALID10
OOS_SKU=QA-OOS-001
LOW_STOCK_SKU=QA-LOW-001
PACK_SIZE_SKU=QA-PACK-001
TIER_PRICED_SKU=QA-TIER-001
CONFIGURABLE_SKU=
