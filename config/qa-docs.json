{
  "$schema": "./qa-docs.schema.json",
  "language": "en",
  "style": {
    "designSystem": ""
  },
  "film": {
    "maxSeconds": 90,
    "maxStories": 10
  },
  "candidates": {
    "include": [
      { "types": ["Story"], "statuses": ["Tested", "Done"], "label": "Story, Tested or Done" },
      { "types": ["Bug", "Task"], "priorities": ["High", "Highest"], "label": "High priority" },
      { "types": ["Bug", "Task"], "importantUpdate": true, "label": "Important update" }
    ],
    "exclude": [
      { "types": ["TechDebt"], "label": "Tech debt" },
      { "types": ["Spike"], "label": "Spike" },
      { "types": ["Review task"], "label": "Review task" },
      { "types": ["Task"], "internalTask": true, "label": "Internal task (no PR in a product repo)" },
      { "types": ["*"], "summaryMatches": "^merge\\b.*\\bto next\\b", "label": "Branch merge into Next" },
      { "types": ["*"], "statuses": ["Cancelled"], "label": "Cancelled" }
    ]
  },
  "slides": {
    "layout": "story-a-why-who",
    "layouts": {
      "story-a-why-who": {
        "description": "Text column on the left, one large screenshot on the right (owner's choice, 2026-11-20).",
        "regions": [
          { "id": "eyebrow", "onScreen": true, "rule": "The product area, short, upper case." },
          { "id": "title", "onScreen": true, "rule": "What changed, as one sentence." },
          { "id": "why", "onScreen": true, "rule": "The ticket's own problem statement, shortened; none in the ticket => no line." },
          { "id": "changes", "onScreen": true, "rule": "3-4 bullets, from the ticket document or as observed on the stand." },
          { "id": "who", "onScreen": true, "rule": "The role the change serves, never a person's name." },
          { "id": "screenshot", "onScreen": true, "rule": "One frame, object-fit contain." },
          { "id": "versions", "onScreen": true, "rule": "Small, bottom right, exactly as probed (prerelease suffix kept)." },
          { "id": "notes", "onScreen": false, "rule": "Ticket key, stand, capture date, QA state, film link if any." }
        ]
      }
    }
  }
}
