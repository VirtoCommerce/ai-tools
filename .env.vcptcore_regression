# --- Risk gate ---------------------------------------------------------------
ENV_RISK=test

# --- Knowledge base -----------------------------------------------------------
# The name the kb records observations on this stand under. Every alias of this
# profile (env name, BACK_URL / FRONT_URL host) is mapped onto it at the write door
# (scripts/kb/core/stands.mjs). Changing it renames the stand in new evidence only.
KB_STAND=vcptcore_regression

# --- Application URLs --------------------------------------------------------
FRONT_URL=https://vcptcore-regression-storefront.govirto.com
BACK_URL=https://vcptcore-regression.govirto.com
STORYBOOK_URL=https://vcptcore-regression-storybook.govirto.com
STORYBOOK_DEV_URL=https://vcptcore-regression-storybook.govirto.com

# --- Deploy manifest (hotfix delivery target — read by /qa-hotfix-check) ------
# This env is provisioned from vc-deploy-dev @ this branch's backend/packages.json.
# `scripts/hotfix-deliver.ts` bumps a module/Platform version here (commit
# "VCST-XXXX: <title>"), then waits for the deploy Action + polls /api/platform/modules.
DEPLOY_REPO=VirtoCommerce/vc-deploy-dev
DEPLOY_BRANCH=vcptcore-regression
DEPLOY_PACKAGES_PATH=backend/packages.json
DEPLOY_PACKAGES_URL=https://github.com/VirtoCommerce/vc-deploy-dev/blob/vcptcore-regression/backend/packages.json

# --- Store configuration -----------------------------------------------------
STORE_ID=B2B-store
STOREFRONT_DOMAIN=vcptcore-regression-storefront.govirto.com
# B2B-store catalog (B2B-mixed) + main fulfillment center, from /api/stores (2026-07-01).
STORE_CATALOG_ID=fc596540864a41bf8ab78734ee7353a3
MAIN_FULFILLMENT_CENTER_ID=142ba5568ae4454aad553ece41b9c3b5

