{
  "//": "TEMPLATE — gen-mcp.mjs writes .mcp.json (gitignored) from this. Restart Claude Code after editing. Windows uses `cmd /c npx`; on Linux/macOS drop the `cmd` + `/c` and call `npx` directly (gen-mcp.mjs does this automatically). No server here takes a token from a file: postman and context7 were removed (VCST-6402), github's token comes from vc-secrets.",
  "//network": "stdio servers launch via npx (an npm registry lookup inside the ~30s MCP startup budget). Package versions are PINNED (not @latest), and gen-mcp.mjs injects NODE_OPTIONS='--dns-result-order=ipv4first' + npm_config_prefer_offline=true on every stdio server — so a broken/slow IPv6 route can't hang that lookup and a cached package resolves with no round-trip (#220). ipv4first alone is used deliberately; --no-network-family-autoselection is a newer flag that would be FATAL in NODE_OPTIONS on the Node-18 floor.",
  "mcpServers": {
    "playwright-chrome": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chrome",
        "--isolated",
        "--viewport-size",
        "1920x1080",
        "--output-dir",
        "reports/bugs/screenshots/_incoming/chrome"
      ]
    },
    "playwright-firefox": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@0.0.83",
        "--browser",
        "firefox",
        "--isolated",
        "--viewport-size",
        "1920x1080",
        "--output-dir",
        "reports/bugs/screenshots/_incoming/firefox"
      ]
    },
    "playwright-edge": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@0.0.83",
        "--browser",
        "msedge",
        "--isolated",
        "--viewport-size",
        "1920x1080",
        "--output-dir",
        "reports/bugs/screenshots/_incoming/edge"
      ]
    },
    "Chrome DevTools": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "chrome-devtools-mcp@1.6.0"
      ],
      "env": {}
    },
    "github": {
      "//": "Hosted GitHub MCP. gen-mcp.mjs REPLACES this entry by the GitHub auth axis (VCST-6402): a PAT axis gets `node ${VC_SECRETS} run github` (the server is declared in .claude/vc-secrets.local.json, mcp-remote carries the token from vc-secrets into the Authorization header); a gh-cli axis gets this header-less entry and signs in with OAuth on first use. No token is ever written here.",
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "azure-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@azure/mcp@3.0.0-beta.32",
        "server",
        "start"
      ]
    },
    "figma-remote-mcp": {
      "//": "Remote Figma MCP is OAuth-ONLY — a PAT / API-key header has no effect (Figma does not support token auth on the remote server). Authenticate via the client's MCP OAuth flow on first use, like atlassian below. FIGMA_API_KEY is NOT used here.",
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    }
  }
}
