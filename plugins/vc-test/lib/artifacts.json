{
  "$comment": "The only list of artifacts (spec §5.1). `row` is the strategy's Artifacts row as .claude/templates/test-strategy.md names it; `derivedFrom` marks an artifact selected whenever that one is. `needs` waits only for selected artifacts. `writes` is relative to the run folder <run>.",
  "artifacts": [
    {
      "id": "test-model",
      "row": "Test model",
      "run": { "skill": "qa-test-model", "model": "opus" },
      "needs": [],
      "lane": null,
      "requires": [],
      "writes": ["<run>/test-model.md"]
    },
    {
      "id": "contract-refresh",
      "row": "Contract refresh",
      "run": { "commands": ["npm run schema:refresh", "npm run graphql:fixtures:validate:refresh"] },
      "needs": [],
      "lane": null,
      "requires": ["back-url"],
      "writes": ["<run>/knowledge/api/graphql-schema.md", "<run>/.graphql-schema.cache.json"]
    },
    {
      "id": "checklist",
      "row": "Checklist",
      "run": { "agent": "test-management-specialist", "brief": "briefs/checklist.md", "model": "sonnet" },
      "needs": ["test-model"],
      "lane": null,
      "requires": [],
      "writes": ["<run>/testing-checklist.md"]
    },
    {
      "id": "ac-checks",
      "row": null,
      "derivedFrom": "checklist",
      "run": { "agent": "qa-backend-expert", "brief": "briefs/ac-checks.md", "model": "sonnet" },
      "needs": ["checklist"],
      "lane": null,
      "requires": ["back-url"],
      "writes": ["<run>/testing-checklist.md", "<run>/ac-checks/**"]
    },
    {
      "id": "ui-checks",
      "row": null,
      "derivedFrom": "checklist",
      "run": { "agent": "qa-frontend-expert", "brief": "briefs/ui-checks.md", "model": "sonnet" },
      "needs": ["checklist", "ac-checks"],
      "lane": "browser:playwright-chrome",
      "requires": ["front-url", "mcp:playwright-chrome"],
      "writes": ["<run>/testing-checklist.md", "<run>/screenshots/**"]
    },
    {
      "id": "exploratory",
      "row": "Exploratory",
      "run": { "skill": "qa-exploratory", "agent": "qa-testing-expert", "model": "sonnet" },
      "needs": ["test-model"],
      "order": "strategy",
      "lane": "browser:playwright-firefox",
      "requires": ["front-url", "mcp:playwright-firefox"],
      "writes": ["<run>/exploratory/**", "<run>/screenshots/**"]
    },
    {
      "id": "visual",
      "row": "Visual lane",
      "run": { "skill": "qa-design", "agent": "ui-ux-expert", "model": "sonnet" },
      "needs": [],
      "lane": "browser:chrome-devtools",
      "requires": ["front-url", "mcp:chrome-devtools"],
      "writes": ["<run>/design-report.md", "<run>/screenshots/**"]
    }
  ],
  "rows_not_run": {
    "Mind map": "U43 — read only in a run",
    "Coverage triage + regression": "U7 — no regression in vc-test",
    "Verifier": "run by /qa-test-strategy before approval",
    "Case authoring": "U18 — kept .spec is out of the prototype"
  }
}
